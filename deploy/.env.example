# Biến cho docker-compose của môi trường dev.
# Sao chép thành deploy/.env rồi sửa. KHÔNG commit deploy/.env.
MYSQL_ROOT_PASSWORD=password
MYSQL_PASSWORD=openmetadata_password

# Biến cho Document Service khi trỏ vào hạ tầng này.
# Bí mật chỉ truyền qua môi trường, không đặt trong configs/*.yml
DS_APP__PROFILE=openmetadata
DS_CATALOG__BASE_URL=http://localhost:8585
DS_CATALOG__BOT_TOKEN=
DS_CATALOG__PINNED_VERSION=1.12
DS_STORAGE__ENDPOINT=http://localhost:8333
DS_STORAGE__BUCKET=raw-documents
DS_STORAGE__ACCESS_KEY=dev-access-key
DS_STORAGE__SECRET_KEY=dev-secret-key
DS_INTENT__KIND=sqlite
DS_RELATIONSHIP__KIND=sqlite
