# Profile adapter: fake (không cần hạ tầng) hoặc openmetadata
DS_PROFILE=fake

# OpenMetadata
DS_OM_BASE_URL=http://localhost:8585
DS_OM_BOT_TOKEN=
DS_OM_PINNED_VERSION=1.12.0
DS_OM_DRIVE_SERVICE_NAME=raw-documents

# Object Storage tương thích S3
DS_S3_ENDPOINT=http://localhost:9000
DS_S3_BUCKET=raw-documents
DS_S3_ACCESS_KEY=
DS_S3_SECRET_KEY=
DS_S3_REGION=us-east-1
DS_S3_PRESIGN_TTL_SECONDS=300

# Intent store: s3_manifest | sqlite
DS_INTENT_STORE=sqlite
DS_SQLITE_PATH=local_data/document_service.sqlite

# Relationship store: lineage | sqlite
DS_RELATIONSHIP_STORE=sqlite

# IdP / SSO
DS_OIDC_JWKS_URL=
DS_OIDC_ISSUER=
DS_OIDC_AUDIENCE=document-service
DS_AUTH_DISABLED=true

# Policy cache cho chế độ DOWNLOAD_ONLY (giây)
DS_POLICY_CACHE_TTL_SECONDS=300
